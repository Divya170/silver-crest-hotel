PORT=4000
# SQLite file shared at the repo root
DATABASE_PATH=../database/app.sqlite
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=8h
# Seeded on first boot only (if no admin exists)
ADMIN_EMAIL=admin@silvercresthotel.local
ADMIN_PASSWORD=SilverCrest!2026
# Used to decide what "today" means when validating check-in dates
HOTEL_TIMEZONE=America/Los_Angeles
